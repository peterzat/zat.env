#!/usr/bin/env bash
set -euo pipefail

# Compute or write the codereview push marker hash.
#
# Single source of truth for the marker directory, UPSTREAM derivation,
# PROJ_HASH derivation, and DIFF_HASH computation that codereview's Step 8
# (marker write), the pre-push hook (marker verify), and codereview-skip
# (one-shot bypass) all depend on. Replaces the parallel bash snippets that
# previously lived in claude/skills/codereview/SKILL.md and
# hooks/pre-push-codereview.sh; those snippets had to stay byte-identical
# for the push gate to work, and silently diverged when the LLM split the
# Step 8 snippet across multiple Bash tool calls (shell variables don't
# persist across Bash tool invocations, so ${UPSTREAM} went empty in the
# second call and the else-branch wrote an empty-tree hash).
#
# Usage:
#   codereview-marker hash       # print DIFF_HASH to stdout
#   codereview-marker write      # compute hash and write to marker file
#   codereview-marker base       # print the review base (ref or empty-tree hash)
#   codereview-marker surface [<ref>]
#                                # print the security-surface files that differ
#                                # between <ref> (default: the review base) and
#                                # the working tree
#   codereview-marker uncommitted
#                                # print tracked files whose changes are not
#                                # committed (review output files excluded)
#   codereview-marker path       # print marker file path to stdout
#   codereview-marker skip-path  # print one-shot skip marker file path to stdout
#
# Uncommitted changes:
#   The marker hashes the base against the working tree, but a push sends only
#   commits. The pre-push hook calls `uncommitted` after the marker matches and
#   refuses the push while it prints anything, so reviewed changes that were
#   never committed (typically /codefix's fixes) cannot vouch for the unfixed
#   commits that would be pushed. Untracked files are neither hashed nor pushed.
#
# Security surface:
#   Every changed file except the review output files and plain markdown.
#   Markdown that instructs an agent is code, not documentation, and stays
#   in: SKILL.md, CLAUDE.md, CLAUDE.local.md, AGENTS.md, global-claude.md
#   (zat.env's source for ~/.claude/CLAUDE.md), and any .md under a .claude/
#   directory. The diff is against the working tree, so committed, staged,
#   and unstaged changes all count.
#
# Exit codes:
#   0  success
#   1  error (not in a git repo, bad usage)
#   2  no reviewable changes (empty diff vs upstream after excluding review
#      output files); informational, no marker written by `write`
#
# Marker location:
#   Markers live in ${XDG_CACHE_HOME:-${HOME}/.cache}/claude-codereview/
#   (mode 0700, per-user). The directory is created on demand. Earlier
#   versions wrote to /tmp/.claude-codereview-<hash>, which was vulnerable
#   to a symlink race when another local user could pre-create the path.
#   Stale markers in /tmp from earlier installs are harmless and may be
#   removed manually.
#
# Upstream resolution (three cases):
#   (a) `@{upstream}` resolves       -> diff against that ref
#   (b) `@{upstream}` absent but
#       `origin/<current-branch>`
#       resolves                     -> diff against `origin/<current-branch>`
#   (c) neither resolves             -> diff against the empty tree (first
#                                       push of a new branch)

EXCLUDES=(':!CODEREVIEW.md' ':!SECURITY.md' ':!TESTING.md' ':!SPEC.md')

usage() {
  cat >&2 <<'EOF'
codereview-marker -- compute or write the codereview push marker hash.

Usage:
  codereview-marker hash       # print DIFF_HASH to stdout (exit 2 if nothing to review)
  codereview-marker write      # compute hash and write to marker file
  codereview-marker base       # print the review base (ref or empty-tree hash)
  codereview-marker surface [<ref>]
                               # print security-surface files changed since <ref>
                               # (default: the review base)
  codereview-marker uncommitted
                               # print tracked files with uncommitted changes
  codereview-marker path       # print marker file path to stdout
  codereview-marker skip-path  # print one-shot skip marker file path to stdout
EOF
  exit 1
}

require_git() {
  git rev-parse --show-toplevel >/dev/null 2>&1 || {
    echo "codereview-marker: not in a git repository" >&2
    exit 1
  }
}

proj_hash() {
  git rev-parse --show-toplevel | md5sum | cut -c1-8
}

marker_dir() {
  local d="${XDG_CACHE_HOME:-${HOME}/.cache}/claude-codereview"
  mkdir -p "${d}"
  chmod 700 "${d}"
  printf '%s' "${d}"
}

marker_path() {
  printf '%s/marker-%s\n' "$(marker_dir)" "$(proj_hash)"
}

skip_path() {
  printf '%s/skip-%s\n' "$(marker_dir)" "$(proj_hash)"
}

resolve_base() {
  local upstream
  upstream=$(git rev-parse --abbrev-ref '@{upstream}' 2>/dev/null) \
    || upstream="origin/$(git rev-parse --abbrev-ref HEAD)"
  if git rev-parse "${upstream}" >/dev/null 2>&1; then
    printf '%s' "${upstream}"
  else
    git hash-object -t tree /dev/null
  fi
}

# True when a changed path belongs to the security surface (see header).
in_surface() {
  local f="$1"
  case "${f}" in
    *.md) ;;
    *) return 0 ;;
  esac
  case "${f##*/}" in
    SKILL.md|CLAUDE.md|CLAUDE.local.md|AGENTS.md|global-claude.md) return 0 ;;
  esac
  case "/${f}" in
    */.claude/*) return 0 ;;
  esac
  return 1
}

# The ref comes from SECURITY_META in a file the repo controls, so it is
# validated before it reaches git: a value beginning with '-' would be parsed
# as an option (`--output=<path>` truncates and overwrites that path).
list_surface() {
  local ref="${1:-}" tree f
  [[ -n "${ref}" ]] || ref=$(resolve_base)
  if [[ "${ref}" == -* ]] || ! tree=$(git rev-parse --verify --quiet "${ref}^{tree}"); then
    printf 'codereview-marker: cannot resolve %s to a tree\n' "${ref}" >&2
    return 1
  fi
  git -c core.quotePath=false diff --name-only -z "${tree}" -- "${EXCLUDES[@]}" \
    | while IFS= read -r -d '' f; do
        if in_surface "${f}"; then printf '%s\n' "${f}"; fi
      done
}

# Tracked files that differ between HEAD (the empty tree on an unborn branch)
# and the working tree, review output files excluded.
list_uncommitted() {
  local head
  head=$(git rev-parse --verify --quiet HEAD) || head=$(git hash-object -t tree /dev/null)
  git -c core.quotePath=false diff --name-only "${head}" -- "${EXCLUDES[@]}"
}

compute_hash() {
  local base
  base=$(resolve_base)
  if git diff --quiet "${base}" -- "${EXCLUDES[@]}" 2>/dev/null; then
    printf 'codereview-marker: no reviewable changes vs %s\n' "${base}" >&2
    return 2
  fi
  git diff "${base}" -- "${EXCLUDES[@]}" 2>/dev/null | sha256sum | cut -c1-16
}

case "${1:-}" in
  hash)
    require_git
    compute_hash
    ;;
  write)
    require_git
    if hash=$(compute_hash); then
      printf '%s\n' "${hash}" > "$(marker_path)"
    else
      exit $?
    fi
    ;;
  base)
    require_git
    printf '%s\n' "$(resolve_base)"
    ;;
  uncommitted)
    require_git
    list_uncommitted
    ;;
  surface)
    require_git
    [[ $# -le 2 ]] || usage
    list_surface "${2:-}"
    ;;
  path)
    require_git
    marker_path
    ;;
  skip-path)
    require_git
    skip_path
    ;;
  *)
    usage
    ;;
esac
